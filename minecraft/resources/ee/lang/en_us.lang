title.amber_armor_0=__UNTRANSLATED__The Cordium Armor Set
title.amber_armor_0_cont=__UNTRANSLATED__Cordium Armor Set Cont.
desc.amber_armor_6=__UNTRANSLATED__Probably the greatest set for
desc.amber_armor_7=__UNTRANSLATED__mining expeditions and making
desc.amber_armor_8=__UNTRANSLATED__some of the weapons from this
desc.amber_armor_9=__UNTRANSLATED__material can make you a
desc.amber_armor_10=__UNTRANSLATED__tricky traveller to catch.
desc.amber_armor_11=__UNTRANSLATED__Full set provides Haste I,
desc.amber_armor_12=__UNTRANSLATED__and nearby entities glow.
desc.chomper_6=__UNTRANSLATED__Only found in the Depths part
desc.chomper_7=__UNTRANSLATED__of the wastelands, digging in
desc.chomper_8=__UNTRANSLATED__the ground and warning anyone
desc.chomper_9=__UNTRANSLATED__who comes close. If you do wake
