tile.botania:flower.blood_hydroangeas.reference=__UNTRANSLATED__嗷呜！美味的血液！美妙的生命！
tile.botania:flower.add_difficulty.name=__UNTRANSLATED__贷款花
tile.botania:flower.add_difficulty.reference=__UNTRANSLATED__增加两点难度换10000Mana
tile.botania:flower.remove_difficulty.name=__UNTRANSLATED__取款花
tile.botania:flower.remove_difficulty.reference=__UNTRANSLATED__40000Mana换减少两点难度
tile.botania:flower.bread_fanatic.name=__UNTRANSLATED__面包狂热爱好者
tile.botania:flower.bread_fanatic.reference=__UNTRANSLATED__面包！面包！给我面包！
tile.botania:flower.running_machine.name=__UNTRANSLATED__跑步机花
tile.botania:flower.running_machine.reference=__UNTRANSLATED__生命在于运动，多跑步身体健康，巧的是这朵花也赞成这个说法
tile.botania:flower.cow.name=__UNTRANSLATED__牛子兰
tile.botania:flower.cow.reference=__UNTRANSLATED__这朵产魔花很爱吃牛肉，如果它有意识，一定会很喜欢铁牛牛肉面的\n牛子？你以为是什么牛？
tile.botania:flower.quest.name=__UNTRANSLATED__任务花
tile.botania:flower.quest.reference=__UNTRANSLATED__言简意赅，十分明了\n它很乐意看到你完成任务
tile.botania:flower.mirror.name=__UNTRANSLATED__镜像花
tile.botania:flower.mirror.reference=__UNTRANSLATED__使用钻石右键一次镜像花，再右键其他花进行绑定\n你可以把它当成一个模仿者，它甚至免费产魔，快说，谢谢镜像花
tile.botania:flower.eat_iron.name=__UNTRANSLATED__食铁花
tile.botania:flower.eat_iron.reference=__UNTRANSLATED__你问为什么不直接喂铁锭？因为它就爱吃热乎的，蒸馍，你不扶器？\n当然，也可以叫它“食铁兽”或者“史铁生”
tile.botania:flower.agricultural.name=__UNTRANSLATED__农业花
tile.botania:flower.agricultural.reference=__UNTRANSLATED__“古希腊掌管农业的神”
tile.botania:flower.lightning.name=__UNTRANSLATED__天劫花
tile.botania:flower.lightning.reference=__UNTRANSLATED__这朵产魔花性格相当恶劣，喜欢看着别人受苦，作为回报，你如果没有因为这些困难而死，它就会给你大量的魔力
tile.botania:flower.thaumaura.name=__UNTRANSLATED__驭灵花
tile.botania:flower.thaumaura.reference=__UNTRANSLATED__它想在平凡之地构筑魔法森林
